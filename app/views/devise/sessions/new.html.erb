<% content_for :title, "Log in | InTrainView" %>

<section class="auth">
  <div class="auth-card">
    <%= render "shared/logo", on: :light, css: "auth-logo" %>
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-lead">Log in to continue your practice.</p>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= f.input :email, required: false, autofocus: true, input_html: { autocomplete: "email" } %>
      <%= f.input :password, required: false, input_html: { autocomplete: "current-password" } %>
      <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>

      <%= f.button :submit, "Log in", class: "btn btn-accent btn-lg w-100 mt-2" %>
    <% end %>

    <p class="auth-switch">New here? <%= link_to "Create an account", new_registration_path(resource_name) %></p>
  </div>
</section>
