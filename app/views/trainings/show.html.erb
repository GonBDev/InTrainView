<div class="container py-5">
  <%= link_to "Back to my trainings", trainings_path, class: "btn btn-outline-secondary mb-3" %>

  <h1><%= @training.target_job %></h1>

  <p>
    <%= @training.challenge_type == "interview" ? "Job interview" : "Salary negotiation" %>
  </p>

  <% if @training.job_description.present? %>
    <h2 class="h4">Job description</h2>
    <%= simple_format @training.job_description %>

  <% end %>
  <div class="container py-5 padding-2">
    <%= link_to "Edit training", edit_training_path(@training), class: "btn btn-primary" %>

    <%= button_to "Delete training", training_path(@training),
    method: :delete,
    class: "btn btn-outline-danger",
    form: { data: { turbo_confirm: "Delete this training and its practice history?" } } %>

    <%= button_to "Start practice", training_chats_path(@training),
      method: :post, class: "btn btn-primary" %>
  </div>

  <section class="mt-4">
  <h2 class="h4">Practice history</h2>

  <% if @chats.any? %>
    <ul class="list-group">
      <% @chats.each do |chat| %>

        <% grades_by_criterion = chat.grades.index_by(&:criterion) %>
<% criteria = Grade::CRITERIA.fetch(@training.challenge_type) %>
<% scores = criteria.filter_map { |criterion| grades_by_criterion[criterion]&.score } %>

<li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-3">
  <div>
    <%= link_to "Practice ##{chat.id}", chat_path(chat) %>
    <span class="text-muted ms-2">
      <%= chat.created_at.strftime("%b %d, %Y at %H:%M") %>
    </span>
  </div>

  <div class="d-flex flex-wrap align-items-center gap-3">
    <div class="d-flex align-items-center gap-2">
      <% criteria.each do |criterion| %>
        <% score = grades_by_criterion[criterion]&.score %>
        <% color = if score.nil?
                     "bg-secondary"
                   elsif score < 5
                     "bg-danger"
                   elsif score < 7
                     "bg-warning"
                   else
                     "bg-success"
                   end %>
        <% description = "#{criterion}: #{score.nil? ? 'Not scored' : "#{score}/10"}" %>

        <span class="d-inline-block rounded-circle border <%= color %>"
              style="width: 14px; height: 14px;"
              role="img"
              aria-label="<%= description %>"
              title="<%= description %>"></span>
      <% end %>

      <span class="fw-bold text-nowrap">
        <% if scores.any? %>
          <%= number_with_precision(scores.sum.fdiv(scores.size), precision: 1) %>/10
        <% else %>
          Not graded
        <% end %>
      </span>
    </div>

    <span class="text-muted text-nowrap">
      <%= pluralize(chat.messages.size, "message") %>
    </span>

    <%= button_to "Delete", chat_path(chat),
        method: :delete,
        class: "btn btn-outline-danger btn-sm",
        form: {
          class: "mb-0",
          data: { turbo_confirm: "Delete this practice and all its messages and feedback?" }
        } %>
  </div>
</li>

      <% end %>
    </ul>
  <% else %>
    <p>You haven’t started a practice session for this training yet.</p>
  <% end %>
</section>
</div>
