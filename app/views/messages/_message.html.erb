<%# One message, shared by the chat page and Turbo replies. %>
<% you = message.role == "user" %>

<div id="<%= dom_id(message) %>"
     data-message-role="<%= message.role %>"
     class="chat-row chat-row-<%= you ? 'you' : 'ai' %><%= ' is-new' if local_assigns[:fresh] %>"
     <% unless you %>data-talkback-target="message"<% end %>>

  <% unless you %>
    <span class="chat-avatar" aria-hidden="true">
      <%= ai_name.first %>
    </span>
  <% end %>

  <div class="chat-bubble">
    <span class="visually-hidden"><%= you ? "You" : ai_name %>:</span>
    <%= simple_format(h(message.content)) %>
  </div>
</div>
