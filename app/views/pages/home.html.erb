<% content_for :title, "InTrainView | Interview and Salary Practice" %>

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 class="hero-title">Practice the interview before the real one.</h1>
      <p class="hero-lead">
        Rehearse job interviews and salary negotiations with an AI that plays
        the other side. Then see a score for each skill and what to improve.
      </p>

      <div class="hero-actions">
        <% if user_signed_in? %>
          <%= link_to "Practice interviewing", new_training_path(challenge_type: "interview"),
              class: "btn btn-accent btn-lg", data: { controller: "ripple", action: "click->ripple#burst" } %>
          <%= link_to "Practice negotiating", new_training_path(challenge_type: "negotiation"),
              class: "btn btn-ghost btn-lg" %>
        <% else %>
          <%= link_to "Create an account", new_user_registration_path, class: "btn btn-accent btn-lg", data: { controller: "ripple", action: "click->ripple#burst" } %>
          <%= link_to "Log in", new_user_session_path, class: "btn btn-ghost btn-lg" %>
        <% end %>
      </div>
    </div>

    <div class="hero-stage" data-controller="tilt" data-action="mousemove->tilt#move mouseleave->tilt#reset">
      <figure class="session-card" data-controller="chat-demo" aria-label="Example of a practice session">
        <div class="session-head">
          <span class="chat-avatar" aria-hidden="true">I</span>
          <span class="session-name">Mock interview: Rails developer</span>
          <span class="session-live">Live</span>
        </div>

        <div class="messages">
          <p class="msg msg-ai chat-step" data-chat-demo-target="step">
            <span class="visually-hidden">Interviewer:</span>
            Tell me about a project you are proud of.
          </p>
          <p class="msg msg-you chat-step" data-chat-demo-target="step">
            <span class="visually-hidden">You:</span>
            I built a booking app with a team of four and led the payments flow.
          </p>
          <p class="msg msg-ai chat-step" data-chat-demo-target="step">
            <span class="visually-hidden">Interviewer:</span>
            What was the hardest decision you made on it?
          </p>
        </div>

        <div class="score-panel chat-step" data-chat-demo-target="step">
          <p class="score-title">Your scores</p>

          <div class="score-row">
            <span>Oral skills</span><span>7/10</span>
            <div class="score-bar" style="--score: 7"><span></span></div>
          </div>
          <div class="score-row is-low">
            <span>Adaptability</span><span>6/10</span>
            <div class="score-bar" style="--score: 6"><span></span></div>
          </div>
          <div class="score-row">
            <span>Industry knowledge</span><span>8/10</span>
            <div class="score-bar" style="--score: 8"><span></span></div>
          </div>

          <p class="score-tip">Next time: link your answers to what the company needs.</p>
        </div>
      </figure>
    </div>
  </div>
</section>

<section class="modes container" aria-labelledby="modes-title" data-controller="carousel" data-action="resize@window->carousel#update">
  <div class="modes-head">
    <h2 id="modes-title" class="section-title">Choose your situation</h2>
    <div class="carousel-buttons">
      <button type="button" class="carousel-btn" data-carousel-target="prev" data-action="carousel#prev" aria-label="Previous">&#8592;</button>
      <button type="button" class="carousel-btn" data-carousel-target="next" data-action="carousel#next" aria-label="Next">&#8594;</button>
    </div>
  </div>

  <div class="tiles" data-carousel-target="track" data-action="scroll->carousel#update">
    <%= link_to new_training_path(challenge_type: "interview"), class: "tile tile-blue", data: { controller: "ripple", action: "click->ripple#burst" } do %>
      <span class="tile-pill">Job interview</span>
      <%= render "shared/tile_art", kind: "interview" %>
      <span class="tile-title">Answer a recruiter's questions</span>
      <span class="tile-go" aria-hidden="true">&#8594;</span>
    <% end %>

    <%= link_to new_training_path(challenge_type: "negotiation"), class: "tile tile-orange", data: { controller: "ripple", action: "click->ripple#burst" } do %>
      <span class="tile-pill">Salary negotiation</span>
      <%= render "shared/tile_art", kind: "negotiation" %>
      <span class="tile-title">Negotiate an offer</span>
      <span class="tile-go" aria-hidden="true">&#8594;</span>
    <% end %>

    <%= link_to new_training_path(challenge_type: "negotiation"), class: "tile tile-slate", data: { controller: "ripple", action: "click->ripple#burst" } do %>
      <span class="tile-pill">Ask for a raise</span>
      <%= render "shared/tile_art", kind: "raise" %>
      <span class="tile-title">Talk to your manager</span>
      <span class="tile-go" aria-hidden="true">&#8594;</span>
    <% end %>

    <%= link_to new_training_path(challenge_type: "interview"), class: "tile tile-light", data: { controller: "ripple", action: "click->ripple#burst" } do %>
      <span class="tile-pill">New career</span>
      <%= render "shared/tile_art", kind: "career" %>
      <span class="tile-title">Interview in a new field</span>
      <span class="tile-go" aria-hidden="true">&#8594;</span>
    <% end %>
  </div>
</section>

<section class="steps container" aria-labelledby="steps-title">
  <h2 id="steps-title" class="section-title">How it works</h2>

  <div class="steps-grid">
    <div class="step">
      <span class="step-number" aria-hidden="true">1</span>
      <h3>Tell us about you</h3>
      <p>
        Answer a few quick questions about your experience. You can skip this
        step, but the practice will fit you better if you do it.
      </p>
    </div>
    <div class="step">
      <span class="step-number" aria-hidden="true">2</span>
      <h3>Practice with the AI</h3>
      <p>
        Choose a job interview or a salary negotiation. The AI plays the other
        side and replies to every answer you give.
      </p>
    </div>
    <div class="step">
      <span class="step-number" aria-hidden="true">3</span>
      <h3>Get your scores and advice</h3>
      <p>
        See a score for each skill, advice on every score, and a summary of
        what to work on next.
      </p>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container cta-inner">
    <h2>Start your first practice session.</h2>
    <% if user_signed_in? %>
      <%= link_to "New training", new_training_path, class: "btn btn-accent btn-lg", data: { controller: "ripple", action: "click->ripple#burst" } %>
    <% else %>
      <%= link_to "Create an account", new_user_registration_path, class: "btn btn-accent btn-lg", data: { controller: "ripple", action: "click->ripple#burst" } %>
    <% end %>
  </div>
</section>
