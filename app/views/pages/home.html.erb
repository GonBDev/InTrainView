<% content_for :title, "InTrainView | Interview and Salary Practice" %>

<section class="bg-dark text-white py-5">
  <div class="container py-md-4">
    <div class="row">
      <div class="col-lg-8">
        <h1 class="display-4 fw-bold">Practice for your next role.</h1>
        <p class="lead">
          Rehearse job interviews and salary negotiations, then get feedback
          on what to improve before the real conversation.
        </p>

        <% unless user_signed_in? %>
          <%= link_to "Create an account", new_user_registration_path,
              class: "btn btn-info btn-lg" %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="container py-5" aria-labelledby="practice-modes">
  <h2 id="practice-modes" class="mb-4">What are you preparing for?</h2>

  <div class="row g-4">
    <div class="col-md-6">
      <article class="card h-100 shadow-sm">
        <div class="card-body p-4">
          <h3 class="h4">Job interview</h3>
          <p class="mb-0">
            Answer questions for your target role and practice explaining
            what you did and the results you achieved.
          </p>
          <%= link_to "Practice interviewing",
              new_training_path(challenge_type: "interview"),
              class: "btn btn-primary mt-3" %>
        </div>
      </article>
    </div>

    <div class="col-md-6">
      <article class="card h-100 shadow-sm">
        <div class="card-body p-4">
          <h3 class="h4">Salary negotiation</h3>
          <p class="mb-0">
            Practice making a counteroffer, explaining your target salary,
            and responding when the hiring manager pushes back.
          </p>
          <%= link_to "Practice negotiating",
              new_training_path(challenge_type: "negotiation"),
              class: "btn btn-primary mt-3" %>
        </div>
      </article>
    </div>
  </div>
</section>
