<% training = @chat.training %>
<% kind = training.challenge_type == "negotiation" ? "negotiation" : "interview" %>
<% ai_name = kind == "negotiation" ? "Manager" : "Interviewer" %>
<% messages = @messages.to_a %>
<% answers = messages.count { |m| m.role == "user" } %>
<% completed = @chat.status == "completed" %>
<% content_for :title, "#{training.target_job} | InTrainView" %>

<section class="chat-page">
  <div class="chat-card<%= ' is-completed' if completed %>" data-controller="chat">

    <header class="chat-top">
      <%= link_to training_path(training), class: "chat-back", aria: { label: "Back to training" } do %>&#8592;<% end %>
      <div class="chat-top-title">
        <h1><%= training.target_job %></h1>
        <span class="chat-badge chat-badge-<%= kind %>"><%= kind == "negotiation" ? "Salary negotiation" : "Job interview" %></span>
      </div>
      <span class="chat-count"><%= pluralize(answers, "answer") %></span>
      <% if !completed && answers > 0 %>
        <%= button_to "Finish", chat_path(@chat), method: :patch, class: "chat-finish",
            form: { class: "chat-finish-form",
                    data: { turbo_confirm: "Finish this practice and get your feedback?" } },
            data: { turbo_submits_with: "Evaluating..." } %>
      <% end %>
    </header>

    <div class="chat-thread" data-chat-target="thread" aria-live="polite">
      <% if messages.empty? %>
        <div class="chat-empty">
          <%= render "shared/tile_art", kind: kind, css: "chat-empty-art" %>
          <h2>Start the conversation</h2>
          <p>Write your first answer, or pick a starter.</p>
          <div class="chat-chips">
            <% starters = kind == "negotiation" ? ["I would like to talk about my salary.", "I received an offer and want to discuss it."] : ["Hello, thank you for having me.", "Let me introduce myself in a few sentences."] %>
            <% starters.each do |text| %>
              <button type="button" class="chat-chip" data-action="chat#fill" data-text="<%= text %>"><%= text %></button>
            <% end %>
          </div>
        </div>
      <% end %>

      <% messages.each_with_index do |message, index| %>
        <% you = message.role == "user" %>
        <div class="chat-row chat-row-<%= you ? 'you' : 'ai' %><%= ' is-new' if index == messages.size - 1 && !completed %>">
          <% unless you %><span class="chat-avatar" aria-hidden="true"><%= ai_name.first %></span><% end %>
          <div class="chat-bubble">
            <span class="visually-hidden"><%= you ? "You" : ai_name %>:</span>
            <%= simple_format(h(message.content)) %>
          </div>
        </div>
      <% end %>

      <div class="chat-row chat-row-ai chat-typing" data-chat-target="typing" hidden>
        <span class="chat-avatar" aria-hidden="true"><%= ai_name.first %></span>
        <div class="chat-bubble" aria-label="<%= ai_name %> is typing">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        </div>
      </div>
    </div>

    <% if completed %>
      <% grades = @chat.grades.to_a.sort_by(&:id) %>
      <% average = chat_average(@chat) %>
      <section class="feedback" aria-labelledby="feedback-title">
        <div class="feedback-head">
          <div>
            <h2 id="feedback-title">Practice complete</h2>
            <p><%= grades.any? ? verdict_for(average) : "Your feedback is not generated yet." %></p>
          </div>
          <div class="feedback-actions">
            <a href="<%= training_path(training) %>" class="btn btn-ghost">Back to training</a>
            <%= button_to "Practice again", training_chats_path(training), method: :post,
                class: "btn btn-accent", form: { class: "inline-form" },
                data: { turbo_submits_with: "Starting..." } %>
          </div>
        </div>

        <% if grades.any? %>
          <div class="feedback-body">
            <div class="score-ring tone-<%= score_tone(average) %>" style="--score: <%= average || 0 %>">
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <circle class="ring-bg" cx="60" cy="60" r="52" pathLength="100"></circle>
                <circle class="ring-fg" cx="60" cy="60" r="52" pathLength="100"></circle>
              </svg>
              <div class="ring-text">
                <% if average %>
                  <strong data-controller="countup" data-countup-end-value="<%= average %>" data-countup-decimals-value="1"><%= format_score(average) %></strong>
                  <span>out of 10</span>
                <% else %>
                  <strong>n/a</strong>
                <% end %>
              </div>
            </div>

            <ul class="criteria">
              <% grades.each_with_index do |grade, index| %>
                <li class="criterion tone-<%= score_tone(grade.score) %>" style="--i: <%= index %>; --v: <%= grade.score.nil? ? 0 : grade.score * 10 %>%">
                  <div class="criterion-head">
                    <h3><%= grade.criterion %></h3>
                    <span class="criterion-score"><%= grade.score.nil? ? "Not enough evidence" : "#{grade.score}/10" %></span>
                  </div>
                  <div class="criterion-bar"><span></span></div>
                  <%= simple_format(h(grade.advice), class: "criterion-advice") %>
                </li>
              <% end %>
            </ul>
          </div>
        <% else %>
          <div class="feedback-empty">
            <%= button_to "Generate feedback", chat_path(@chat), method: :patch,
                class: "btn btn-accent btn-lg", form: { class: "inline-form" },
                data: { turbo_submits_with: "Evaluating..." } %>
          </div>
        <% end %>
      </section>
    <% else %>
      <div data-controller="voice"
          data-voice-url-value="<%= chat_transcriptions_path(@chat) %>">

        <%= form_with model: [@chat, @message],
            class: "chat-composer",
            data: { chat_target: "form", action: "submit->chat#sending" } do |f| %>

          <% if @message.errors.any? %>
            <p class="chat-error"><%= @message.errors.full_messages.to_sentence %></p>
          <% end %>

          <div class="chat-box">
            <%= f.text_area :content,
                rows: 1,
                placeholder: "Type your answer",
                "aria-label": "Your answer",
                data: {
                  chat_target: "input",
                  voice_target: "input",
                  action: "input->chat#autosize keydown->chat#keydown"
                } %>

            <button type="button"
                    class="chat-send"
                    aria-label="Start recording"
                    aria-pressed="false"
                    title="Start recording"
                    data-voice-target="record stop"
                    data-action="voice#toggle">
              🎤
            </button>

            <%= f.button type: "submit",
                class: "chat-send",
                "aria-label": "Send",
                data: {
                  chat_target: "send",
                  controller: "ripple",
                  action: "click->ripple#burst"
                } do %>
              &#8593;
            <% end %>
          </div>

          <p data-voice-target="status" role="status" class="chat-hint"></p>

          <audio data-voice-target="playback"
                controls
                aria-label="Your recorded answer"
                hidden></audio>

          <p class="chat-hint">Enter to send. Shift+Enter for a new line.</p>
        <% end %>
      </div>

      <% if answers > 0 %>
        <div class="p-3">
          <%= button_to "Finish practice", chat_path(@chat),
              method: :patch,
              class: "btn btn-outline-primary",
              form: {
                data: { turbo_confirm: "Finish this practice and get your feedback?" }
              },
              data: { turbo_submits_with: "Evaluating…" } %>
        </div>
      <% end %>s the text form-->
    <% end %>

  </div>
</section>
