<% training = @chat.training %>
<% kind = training.challenge_type == "negotiation" ? "negotiation" : "interview" %>
<% ai_name = kind == "negotiation" ? "Manager" : "Interviewer" %>
<% messages = @messages.to_a %>
<% content_for :title, "#{training.target_job} | InTrainView" %>

<section class="chat-page">
  <div class="chat-card" data-controller="chat">

    <header class="chat-top">
      <%= link_to training_path(training), class: "chat-back", aria: { label: "Back to training" } do %>&#8592;<% end %>
      <div class="chat-top-title">
        <h1><%= training.target_job %></h1>
        <span class="chat-badge chat-badge-<%= kind %>"><%= kind == "negotiation" ? "Salary negotiation" : "Job interview" %></span>
      </div>
      <span class="chat-count"><%= pluralize(messages.count { |m| m.role == "user" }, "answer") %></span>
    </header>

    <div class="chat-thread" data-chat-target="thread" aria-live="polite">
      <% if messages.empty? %>
        <div class="chat-empty">
          <%= render "shared/tile_art", kind: kind, css: "chat-empty-art" %>
          <h2>Start the conversation</h2>
          <p>Write your first answer, or pick a starter.</p>
          <div class="chat-chips">
            <% starters = kind == "negotiation" ? ["I would like to talk about my salary.", "I received an offer and want to discuss it."] : ["Hello, thank you for having me.", "Let me introduce myself in a few sentences."] %>
            <% starters.each do |text| %>
              <button type="button" class="chat-chip" data-action="chat#fill" data-text="<%= text %>"><%= text %></button>
            <% end %>
          </div>
        </div>
      <% end %>

      <% messages.each_with_index do |message, index| %>
        <% you = message.role == "user" %>
        <div class="chat-row chat-row-<%= you ? 'you' : 'ai' %><%= ' is-new' if index == messages.size - 1 %>">
          <% unless you %><span class="chat-avatar" aria-hidden="true"><%= ai_name.first %></span><% end %>
          <div class="chat-bubble">
            <span class="visually-hidden"><%= you ? "You" : ai_name %>:</span>
            <%= simple_format(h(message.content)) %>
          </div>
        </div>
      <% end %>

      <div class="chat-row chat-row-ai chat-typing" data-chat-target="typing" hidden>
        <span class="chat-avatar" aria-hidden="true"><%= ai_name.first %></span>
        <div class="chat-bubble" aria-label="<%= ai_name %> is typing">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        </div>
      </div>
    </div>

    <% if @chat.status == "completed" %>
      <p class="p-3 mb-0">This practice session is complete.</p>

        <section class="p-3" aria-labelledby="practice-feedback">
          <h2 id="practice-feedback" class="h4">Your feedback</h2>

          <% if @chat.grades.exists? %>
<% grades_by_criterion = @chat.grades.index_by(&:criterion) %>
<% criteria = Grade::CRITERIA.fetch(@chat.training.challenge_type) %>
<% scores = criteria.filter_map { |criterion| grades_by_criterion[criterion]&.score } %>

<div class="d-flex align-items-center gap-2 mb-3">
  <% criteria.each do |criterion| %>
    <% score = grades_by_criterion[criterion]&.score %>
    <% color = if score.nil?
                 "bg-secondary"
               elsif score < 5
                 "bg-danger"
               elsif score < 7
                 "bg-warning"
               else
                 "bg-success"
               end %>
    <% description = "#{criterion}: #{score.nil? ? 'Not scored' : "#{score}/10"}" %>

    <span class="d-inline-block rounded-circle border <%= color %>"
          style="width: 14px; height: 14px;"
          role="img"
          aria-label="<%= description %>"
          title="<%= description %>"></span>
  <% end %>

  <span class="fw-bold text-nowrap ms-2">
    <% if scores.any? %>
      <%= number_with_precision(scores.sum.fdiv(scores.size), precision: 1) %>/10
    <% else %>
      Not scored
    <% end %>
  </span>
</div>



            <% @chat.grades.order(:id).each do |grade| %>
              <article class="border rounded p-3 mb-3">
                <h3 class="h5"><%= grade.criterion %></h3>

                <p>
                  <strong>
                    <%= grade.score.nil? ? "Insufficient evidence" : "#{grade.score}/10" %>
                  </strong>
                </p>

                <%= simple_format(grade.advice) %>
              </article>
            <% end %>
          <% else %>
            <%= button_to "Generate feedback", chat_path(@chat),
                method: :patch,
                class: "btn btn-primary",
                data: { turbo_submits_with: "Evaluating…" } %>
          <% end %>
        </section>


    <% else %>
      <%= button_to "Finish practice", chat_path(@chat),
        method: :patch,
        class: "btn btn-outline-primary",
        form: {
          data: { turbo_confirm: "Finish this practice session?" }
      } %>

      <%= form_with model: [@chat, @message], class: "chat-composer", data: { chat_target: "form", action: "submit->chat#sending" } do |f| %>
        <% if @message.errors.any? %>
          <p class="chat-error"><%= @message.errors.full_messages.to_sentence %></p>
        <% end %>
        <div class="chat-box">
          <%= f.text_area :content, rows: 1, placeholder: "Type your answer", "aria-label": "Your answer",
              data: { chat_target: "input", action: "input->chat#autosize keydown->chat#keydown" } %>
          <%= f.button type: "submit", class: "chat-send", "aria-label": "Send",
              data: { chat_target: "send", controller: "ripple", action: "click->ripple#burst" } do %>&#8593;<% end %>
        </div>
        <p class="chat-hint">Enter to send. Shift+Enter for a new line.</p>
      <% end %>
    <% end %>
  </div>
</section>
