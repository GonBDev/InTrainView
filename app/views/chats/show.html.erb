<div class="container py-5">
  <%= link_to "Back to training", training_path(@chat.training) %>
  <h1><%= @chat.training.target_job %></h1>

  <% if @messages.empty? %>
    <p>No messages yet.</p>
  <% else %>
    <% @messages.each do |message| %>
      <p>
        <strong><%= message.role == "user" ? "You" : "Interviewer" %></strong>
        <%= message.content %>
      </p>
    <% end %>
  <% end %>

<%= simple_form_for [@chat, @message] do |f| %>
  <%= f.input :content,
      as: :string,
      label: "Your answer",
      placeholder: "Type your answer and press Enter",
      input_html: { autocomplete: "off" } %>
  <%= f.button :submit, "Send", class: "btn btn-primary" %>
<% end %>


</div>
